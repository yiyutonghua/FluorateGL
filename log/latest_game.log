};

out vec4 fragColor;
in float vertexDistance;

vec4 linear_fog(vec4 inColor, float vertexDistance_1, float fogStart, float fogEnd, vec4 fogColor)
{
    if (vertexDistance_1 <= fogStart)
    {
        return inColor;
    }
    float _31;
    if (vertexDistance_1 < fogEnd)
    {
        _31 = smoothstep(fogStart, fogEnd, vertexDistance_1);
    }
    else
