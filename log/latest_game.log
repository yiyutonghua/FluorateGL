precision highp float;
precision highp int;

layout(std140) uniform UniformBlockVS
{
    mat4 ModelViewMat;
    mat4 ProjMat;
    mat4 TextureMat;
    int FogShape;
};

in vec3 Position;
out float vertexDistance;
out vec2 texCoord0;
in vec2 UV0;

float fog_distance(vec3 pos, int shape)
{
    if (shape == 0)
    {
        return length(pos);
    }
    else
    {
        float distXZ = length(pos.xz);
        float distY = abs(pos.y);
        return max(distXZ, distY);
    }
}

