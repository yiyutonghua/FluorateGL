#version 310 es
precision highp float;
precision highp int;

layout(std140) uniform UniformBlockVS
{
    mat4 ModelViewMat;
    mat4 ProjMat;
    vec3 ChunkOffset;
    int FogShape;
};

uniform highp sampler2D Sampler2;

in vec3 Position;
out float vertexDistance;
out vec4 vertexColor;
in vec4 Color;
in ivec2 UV2;
out vec2 texCoord0;
in vec2 UV0;
in vec3 Normal;

float fog_distance(vec3 pos, int shape)
{
    if (shape == 0)
    {
        return length(pos);
    }
    else
    {
        float distXZ = length(pos.xz);
        float distY = abs(pos.y);
        return max(distXZ, distY);
    }
}

vec4 minecraft_sample_lightmap(highp sampler2D lightMap, ivec2 uv)
{
    return textureLod(lightMap, clamp(vec2(uv) / vec2(256.0), vec2(0.03125), vec2(0.96875)), 0.0);
}

void main()
{
    vec3 pos = Position + ChunkOffset;
    gl_Position = (ProjMat * ModelViewMat) * vec4(pos, 1.0);
    vec3 param = pos;
    int param_1 = FogShape;
    vertexDistance = fog_distance(param, param_1);
    ivec2 param_2 = UV2;
    vertexColor = Color * minecraft_sample_lightmap(Sampler2, param_2);
    texCoord0 = UV0;
}

